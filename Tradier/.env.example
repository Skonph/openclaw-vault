# ─────────────────────────────────────────────────────────────────
# Tradier Dual-API Setup — Skon's $2K Paper Trading POC
# ─────────────────────────────────────────────────────────────────
# Get keys from: https://developer.tradier.com → Applications
#
# ARCHITECTURE:
#   PROD  → api.tradier.com     → real-time quotes + options chains
#   SANDBOX → sandbox.tradier.com → paper order execution + account P&L
# ─────────────────────────────────────────────────────────────────

# Production API key (api.tradier.com)
# Used ONLY for reading live market data — never executes real trades
TRADIER_PROD_TOKEN=your_production_api_token_here

# Sandbox API key (sandbox.tradier.com)
# Used for paper trade execution, positions, and account balance
TRADIER_SANDBOX_TOKEN=your_sandbox_api_token_here

# Your sandbox (paper trading) account ID
# Find it at sandbox.tradier.com after logging in → Account dropdown
TRADIER_SANDBOX_ACCOUNT=your_sandbox_account_id_here

# POC benchmark capital — your personal $2K target to track against
# (Sandbox gives $100K virtual; this keeps P&L tracking honest)
STARTING_CAPITAL=2000

# ─── Telegram notification (via OpenClaw bot — used by run_scan.sh on Ubuntu) ─
# Reuse the same bot token + chat ID that OpenClaw already uses.
# BOT_TOKEN: from @BotFather on Telegram
# CHAT_ID:   your personal chat ID or group ID (get it from @userinfobot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
