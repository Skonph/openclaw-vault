# OpenClaw — Dedicated Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
#
# Server path: /home/ubuntu/openclaw/.env
# Mac path (nova_executor): /Users/SkonP/AI_Prompt/Obsidient/SkonVault/openclaw/.env.local

# ── Alpaca Paper Trading ───────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ── Tradier (options data) ─────────────────────────────────────────────────────
TRADIER_API_KEY=your_tradier_token_here

# ── Telegram (notifications) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Anthropic API (optional — conviction scorer upgrades to Claude Haiku if set) ──
# ANTHROPIC_API_KEY=your_anthropic_key_here
