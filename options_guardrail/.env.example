# Copy to /opt/guardrail/.env on the Ubuntu box, fill in, then: chmod 600 .env
# NEVER commit the real .env. Secrets only live here.

# --- Strategist model access ---
# Provider auto-detects: if OPENROUTER_API_KEY is set it uses OpenRouter, else Anthropic.
# Override with STRATEGIST_PROVIDER=openrouter|anthropic.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# STRATEGIST_PROVIDER=openrouter
STRATEGIST_MODEL=anthropic/claude-haiku-4.5   # Haiku tier, near-Sonnet reasoning (NOT claude-3-haiku).
# Alternatives: anthropic/claude-sonnet-4.5 (better plans, pricier) | anthropic/claude-haiku-latest
# STRATEGIST_PROMPT_PATH=/opt/guardrail/strategist_prompt.md   # default: alongside code

# --- Telegram (NEW dedicated bot: BotFather /newbot, then DM it once) ---
TELEGRAM_BOT_TOKEN=PASTE_NEW_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=8069530075
APPROVAL_TIMEOUT_SEC=900        # semi-mode: auto-reject a plan after 15 min of silence

# --- IBKR (paper) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                  # 7497 = paper TWS/Gateway; 4002 = paper Gateway std
IBKR_CLIENT_ID=17
IBKR_PAPER_ONLY=true           # executor refuses any account not starting DU/DF

# --- Tradier (DATA feed for the strategist; execution stays on IBKR) ---
# Set prod for real-time data. The prod token CAN trade your live account, but this
# system only uses it for read-only /markets/* data — never pass it to a broker/executor.
TRADIER_ENV=prod               # 'prod' = real-time (if entitled); 'sandbox' = delayed/free
TRADIER_PROD_TOKEN=your_tradier_prod_token
# TRADIER_SANDBOX_TOKEN=...     # used when TRADIER_ENV=sandbox
# TRADIER_SANDBOX_ACCOUNT=...
# TRADIER_API_KEY=...           # fallback token name for either env
# TRADIER_BASE_URL=             # override; defaults by env

# Verify it works:  ./run.sh tradier_feed.py SPY QQQ

# --- Economic calendar (event risk). Finnhub preferred, FRED fallback. ---
FINNHUB_API_KEY=your_finnhub_key
FRED_API_KEY=your_fred_key

# --- runtime ---
GUARDRAIL_MODE=auto            # 'auto' = fully autonomous (notifications only); 'semi' = approval per entry
# OPTIONS_LEVEL controls permitted option structures. 2 = debit spreads only; 3 = credit spreads, Iron Condors, etc. (Level 4 account allows setting this to 3)
OPTIONS_LEVEL=3
# Marked-equity kill-switch: when true (default), unrealized P&L of open
# positions is added to realized equity when checking day/week drawdown limits.
# Set to false to revert to realized-only kill-switch behavior.
MARKED_EQUITY_KILLSWITCH=true
# Equity the 2% / drawdown caps are computed against. If unset, falls back to STARTING_CAPITAL.
# GUARDRAIL_EQUITY=100000
STARTING_CAPITAL=100000
GUARDRAIL_DATA_DIR=/opt/guardrail/data
