[Unit]
Description=Run the Guardrail Strategist on weekday evenings (US pre-session)

[Timer]
# 08:30 UTC, Mon-Fri. US RTH opens 13:30/14:30 UTC (DST). This is ~5h before the
# open and well clear of IBKR's overnight Gateway restart. Adjust to your window.
OnCalendar=Mon-Fri *-*-* 08:30:00 UTC
OnCalendar=Mon-Fri *-*-* 14:10:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
