# OpenClaw — gitignore
# ─────────────────────
# Local credentials (NEVER commit)
trading-bot/.env.local

# macOS system files
.DS_Store
**/.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Editor
.vscode/
.idea/
*.swp
*.swo

# Large installers and binaries
options_guardrail/ibgateway-stable-standalone-linux-x64.sh
options_guardrail/IBCLinux-3.23.0.zip
*.zip
*.tar.gz
*.tgz

# Local environments, databases, and virtualenvs
**/venv/
**/.venv/
**/logs/
**/data/
.env
.env.local
**/.env
**/.env.local

# Runtime Logs and Temporary Office Locks
*.log
**/*.log
~$*
**/~$*

# Databases and Local Runtime Caches
*.db
*.db-wal
*.db-shm
*.db-journal
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
.spot_cache.json
**/.spot_cache.json

# Scratchpad, Archives, and System Backups
scratch/
shared/archive/
shared/cot_data/
shared/systemd_backup/

# Obsidian Local Workspace State
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Local Configuration Secrets
openclaw.json

